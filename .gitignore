# Root = wac-website public site (Next.js). Workspaces: apps/ci, apps/backend, packages/*.

# Dependencies (hoisted by npm workspaces)
node_modules/
**/node_modules/
/.pnp
.pnp.js

# Next.js generated
next-env.d.ts

# Prisma local db
/prisma/dev.db
/prisma/dev.db-journal

# Build artifacts
**/.next/
**/dist/
**/build/
**/out/
**/.vercel/
**/.turbo/
**/tsconfig.tsbuildinfo

# Env files
**/.env
**/.env.local
**/.env.*.local
# Local env backups (rollback copies — contain secrets)
*.supabase.bak
.env*.bak

# OS / editor
.DS_Store
.idea/
*.log

# Test output
**/coverage/

# Claude Code local state — temp worktrees are throwaway duplicates, never commit
**/.claude/worktrees/
.claude/settings.local.json

# Prototype scratch lockfiles (not part of any build)
apps/ci/prototype/**/package-lock.json
.vercel
