# ─────────────────────────────────────────────────────────────────────────────
# wac-website (public marketing site) — environment variables
#
# Deployment: Vercel project `wac-website`, Root Directory = `.` (this repo root).
# Lives at the repo root; apps/ci and apps/backend are nested workspaces.
# Branch → environment: main = production, staging = staging.
# Set these in Vercel per scope (Production / Preview-scoped-to-`staging`).
# ─────────────────────────────────────────────────────────────────────────────

# Database — Neon Postgres (project: wac-website / restless-feather-64294935)
# Production env → Neon `main` branch · Preview(staging) env → Neon `staging` branch.
# Pooled URL is used at runtime; direct URL is used for prisma db push/migrate.
DATABASE_URL="postgresql://[user]:[password]@[ep]-pooler.[region].aws.neon.tech/[db]?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[ep].[region].aws.neon.tech/[db]?sslmode=require"

# Auth — must be IDENTICAL across wac-website, the backend app, and
# collaborative-intelligence so the shared `wac-customer-token` JWT verifies.
JWT_SECRET="your_jwt_secret_here"

# Cross-app URLs (3-tier ecosystem). Empty NEXT_PUBLIC_APP_URL = auth/portal
# still co-located on this origin (relative links). Set it once the backend app
# is live on its subdomain to flip every cross-link. See lib/urls.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3003"          # prod: https://wearecollaborative.net
NEXT_PUBLIC_APP_URL=""                                  # prod: https://app.wearecollaborative.net
NEXT_PUBLIC_CI_URL="http://localhost:3000"             # prod: https://intelligence.wearecollaborative.net

# AI chat — https://ai.google.dev/  (store as a secret; never commit the value)
GOOGLE_GENERATIVE_AI_API_KEY="your_api_key_here"

# Midtrans payment gateway — https://dashboard.midtrans.com/
MIDTRANS_SERVER_KEY="your_midtrans_server_key_here"
MIDTRANS_CLIENT_KEY="your_midtrans_client_key_here"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your_midtrans_public_client_key_here"
MIDTRANS_IS_PRODUCTION="false"
